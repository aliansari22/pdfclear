# separately or add them intentionally through Git LFS/release assets.
public/assets/fonts/
*.ttf
*.otf
*.woff
*.woff2

# Large local AI/OCR/model assets. Keep these out of Git by default.
public/models/
public/.cache/
public/onnx/
public/tessdata/
public/tesseract/
public/assets/models/
*.onnx
*.safetensors
*.bin
*.gguf
*.tflite

