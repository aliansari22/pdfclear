# PDFClear is a browser application. Never put secrets in VITE_* variables:
# Vite embeds them in the public client bundle.

# Public links used by the website UI.
VITE_SITE_URL=https://www.pdfclear.com
VITE_GITHUB_REPOSITORY_URL=https://github.com/aliansari22/pdfclear

# Model loading behavior for Transformers.js.
# The source package does not include large local model files, so local lookup is off by default.
VITE_TRANSFORMERS_REMOTE_MODELS=true
VITE_TRANSFORMERS_LOCAL_MODELS=false
VITE_TRANSFORMERS_LOCAL_MODEL_PATH=/models/

# Optional URL/path for a self-hosted Unicode-capable TrueType font used by jsPDF.
# Leave empty to use jsPDF's built-in Helvetica fallback.
VITE_PDF_CUSTOM_FONT_URL=
